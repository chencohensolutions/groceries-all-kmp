-- One store per chain (the online store), so (chain, barcode) is unique.
CREATE TABLE product (
    chain TEXT NOT NULL,
    barcode TEXT NOT NULL,
    name TEXT NOT NULL,
    manufacturer TEXT,
    price INTEGER NOT NULL,           -- agorot
    unit_qty TEXT,
    quantity TEXT,
    unit_of_measure TEXT,
    unit_price INTEGER,               -- agorot per unit of measure
    is_weighted INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (chain, barcode)
);

CREATE INDEX product_barcode ON product(barcode);

CREATE TABLE chain_store (
    chain TEXT NOT NULL PRIMARY KEY,
    store_id TEXT NOT NULL,
    store_name TEXT
);

CREATE TABLE sync_state (
    chain TEXT NOT NULL PRIMARY KEY,
    file_name TEXT NOT NULL,
    synced_at INTEGER NOT NULL,       -- epoch millis
    item_count INTEGER NOT NULL
);

CREATE TABLE chain_settings (
    chain TEXT NOT NULL PRIMARY KEY,
    delivery_fee INTEGER NOT NULL DEFAULT 0,   -- agorot
    min_order INTEGER NOT NULL DEFAULT 0,      -- agorot
    enabled INTEGER NOT NULL DEFAULT 1
);

-- Resolved product photo per barcode; url NULL = looked everywhere, nothing found.
CREATE TABLE product_image (
    barcode TEXT NOT NULL PRIMARY KEY,
    url TEXT,
    checked_at INTEGER NOT NULL       -- epoch millis
);

CREATE TABLE order_item (
    barcode TEXT NOT NULL PRIMARY KEY,
    display_name TEXT NOT NULL,
    quantity REAL NOT NULL
);

-- products --------------------------------------------------------------

deleteChainProducts:
DELETE FROM product WHERE chain = ?;

insertProduct:
INSERT OR REPLACE INTO product(chain, barcode, name, manufacturer, price, unit_qty, quantity, unit_of_measure, unit_price, is_weighted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

searchProducts:
SELECT chain, barcode, name, manufacturer, price
FROM product
WHERE barcode IN (
    SELECT DISTINCT barcode FROM product
    WHERE name LIKE '%' || :query || '%' OR barcode = :query
    LIMIT :limit
)
ORDER BY name;

pricesForBarcodes:
SELECT chain, barcode, price FROM product WHERE barcode IN ?;

productCounts:
SELECT chain, COUNT(*) AS item_count FROM product GROUP BY chain;

-- stores ----------------------------------------------------------------

selectStore:
SELECT * FROM chain_store WHERE chain = ?;

selectStores:
SELECT * FROM chain_store;

upsertStore:
INSERT OR REPLACE INTO chain_store(chain, store_id, store_name) VALUES (?, ?, ?);

-- sync state ------------------------------------------------------------

selectSyncStates:
SELECT * FROM sync_state;

selectSyncState:
SELECT * FROM sync_state WHERE chain = ?;

upsertSyncState:
INSERT OR REPLACE INTO sync_state(chain, file_name, synced_at, item_count) VALUES (?, ?, ?, ?);

-- settings --------------------------------------------------------------

selectSettings:
SELECT * FROM chain_settings;

ensureSettings:
INSERT OR IGNORE INTO chain_settings(chain) VALUES (?);

updateFees:
UPDATE chain_settings SET delivery_fee = ?, min_order = ? WHERE chain = ?;

updateEnabled:
UPDATE chain_settings SET enabled = ? WHERE chain = ?;

-- product images ------------------------------------------------------

selectImage:
SELECT * FROM product_image WHERE barcode = ?;

upsertImage:
INSERT OR REPLACE INTO product_image(barcode, url, checked_at) VALUES (?, ?, ?);

-- order list ------------------------------------------------------------

selectOrder:
SELECT * FROM order_item ORDER BY display_name;

selectOrderItem:
SELECT * FROM order_item WHERE barcode = ?;

upsertOrderItem:
INSERT OR REPLACE INTO order_item(barcode, display_name, quantity) VALUES (?, ?, ?);

deleteOrderItem:
DELETE FROM order_item WHERE barcode = ?;

clearOrder:
DELETE FROM order_item;
